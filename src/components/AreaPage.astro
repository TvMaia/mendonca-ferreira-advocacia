---
import Layout from '../layouts/Layout.astro';

const { title, subtitle, heroImg, roman = 'I', lawyer, waMsg, metaDesc } = Astro.props;

const B = (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/');
const WA = '5511953545061';
const waLink = `https://api.whatsapp.com/send?phone=${WA}&text=${encodeURIComponent(waMsg)}`;
---

<Layout title={`${title} — Mendonça & Ferreira Advocacia`} description={metaDesc} areaWaMsg={waMsg}>

  <!-- MINI-HERO -->
  <section class="ah" style={`--ah-img: url('${B}images/${heroImg}')`}>
    <div class="ah__overlay"></div>
    <div class="container ah__wrap">
      <div class="ah__crumb reveal">
        <a href={B}>Início</a>
        <span>/</span>
        <a href={`${B}#areas`}>Áreas de Atuação</a>
      </div>
      <span class="ah__roman reveal">{roman}</span>
      <h1 class="ah__title reveal reveal-delay-1">{title}</h1>
      <p class="ah__sub reveal reveal-delay-2">{subtitle}</p>
      <div class="ah__actions reveal reveal-delay-3">
        <a href={waLink} class="btn btn-filled" target="_blank" rel="noopener">
          <span>Falar sobre o meu caso</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CORPO -->
  <section class="abody">
    <div class="container">
      <div class="abody__grid">
        <div class="abody__content reveal">
          <slot />
        </div>
        <aside class="abody__side">
          <div class="lawyer reveal-right">
            <div class="lawyer__frame">
              <img class="lawyer__img" src={`${B}images/${lawyer.img}`} alt={lawyer.name} />
            </div>
            <div class="lawyer__meta">
              <span class="label">Advogado responsável</span>
              <h3 class="lawyer__name">{lawyer.name}</h3>
              <p class="lawyer__role">{lawyer.role}</p>
              <p class="lawyer__oab">{lawyer.oab}</p>
              <p class="lawyer__bio">{lawyer.bio}</p>
              <a href={waLink} class="btn" target="_blank" rel="noopener" style="margin-top:0.5rem;">
                <span>Falar no WhatsApp</span>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section class="process">
    <div class="container">
      <div class="sec-head reveal">
        <span class="gold-line"></span>
        <span class="label">Como funciona</span>
        <h2 class="sec-title">Simples, do primeiro contato à <em>decisão</em></h2>
      </div>
      <div class="process__steps">
        <div class="process__step reveal">
          <div class="process__step-dot" data-step="0">I</div>
          <h3 class="process__step-title">Você conta o seu caso</h3>
          <p class="process__step-text">Pelo WhatsApp, sem compromisso. Você explica a sua situação e envia os documentos que tiver em mãos.</p>
        </div>
        <div class="process__step reveal reveal-delay-1">
          <div class="process__step-dot" data-step="1">II</div>
          <h3 class="process__step-title">Análise e orientação</h3>
          <p class="process__step-text">Avaliamos o caso e explicamos, com clareza e sem juridiquês, os caminhos possíveis e o que esperar de cada um.</p>
        </div>
        <div class="process__step reveal reveal-delay-2">
          <div class="process__step-dot" data-step="2">III</div>
          <h3 class="process__step-title">Condução do início ao fim</h3>
          <p class="process__step-text">Seguindo com o escritório, acompanhamos cada etapa e mantemos você informado até a decisão final.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="cta__corner cta__corner--tl"></div>
    <div class="cta__corner cta__corner--tr"></div>
    <div class="cta__corner cta__corner--bl"></div>
    <div class="cta__corner cta__corner--br"></div>
    <div class="container">
      <span class="gold-line reveal"></span>
      <span class="label reveal">Tire a sua dúvida</span>
      <h2 class="cta__heading reveal reveal-delay-1">Não fique com a dúvida.<br><em>Fale com o escritório.</em></h2>
      <p class="cta__sub reveal reveal-delay-2">Uma conversa inicial ajuda a entender o seu caso e os caminhos possíveis. O atendimento é discreto e sem compromisso.</p>
      <div class="cta__actions reveal reveal-delay-3">
        <a href={waLink} class="btn btn-filled" target="_blank" rel="noopener">
          <span>Falar pelo WhatsApp</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href={`${B}#areas`} class="btn"><span>Ver outras áreas</span></a>
      </div>
      <p class="cta__disclaimer reveal">Sigilo protegido pelo Estatuto da OAB. Seus dados não são compartilhados.</p>
    </div>
  </section>

  <style>
    /* "Como funciona" tem 3 passos aqui (a home tem 4) — grid próprio pra não
       herdar o de 4 colunas do Layout e ficar puxado pra esquerda */
    .process__steps { grid-template-columns:repeat(3,1fr); }
    .process__steps::before { left:16.667%; right:16.667%; }

    /* MINI-HERO da área */
    .ah { position:relative; padding:12rem 0 5rem; overflow:hidden; border-bottom:1px solid var(--gold-border); }
    .ah::before { content:''; position:absolute; inset:0; background-image:var(--ah-img); background-size:cover; background-position:center; filter:grayscale(1) contrast(1.05) brightness(1.02) sepia(0.24) hue-rotate(-10deg); transform:scale(1.04); }
    .ah__overlay { position:absolute; inset:0; background:linear-gradient(to bottom, rgba(10,10,10,0.5) 0%, rgba(10,10,10,0.72) 52%, rgba(10,10,10,0.95) 100%); }
    .ah__overlay::after { content:''; position:absolute; inset:0; background:radial-gradient(ellipse 70% 60% at 15% 30%, rgba(201,168,76,0.10), transparent); }
    .ah__wrap { position:relative; z-index:2; max-width:820px; }
    .ah__crumb { display:flex; gap:0.6rem; align-items:center; font-size:0.7rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--white-dim); margin-bottom:2rem; }
    .ah__crumb a:hover { color:var(--gold); }
    .ah__crumb span { color:var(--gold); opacity:0.5; }
    .ah__roman { font-family:var(--font-display); font-style:italic; font-size:1.4rem; color:var(--gold); }
    .ah__title { font-family:var(--font-display); font-size:clamp(2.6rem,6vw,5rem); font-weight:300; line-height:1.05; margin:0.4rem 0 1.2rem; }
    .ah__sub { font-size:1.15rem; color:var(--white-dim); max-width:600px; margin-bottom:2.5rem; line-height:1.6; }

    /* CORPO */
    .abody { padding:6rem 0; }
    .abody__grid { display:grid; grid-template-columns:1.6fr 1fr; gap:5rem; align-items:start; }
    .abody__content :global(.svc-lead) { font-family:var(--font-display); font-size:1.5rem; font-weight:400; line-height:1.4; color:var(--white); margin-bottom:1.8rem; }
    .abody__content :global(.svc-lead em) { font-style:italic; color:var(--gold); }
    .abody__content :global(p) { color:var(--white-dim); font-size:1rem; margin-bottom:1.3rem; line-height:1.8; }
    .abody__content :global(.svc-block) { margin-top:2.5rem; }
    .abody__content :global(.svc-block-title) { font-family:var(--font-display); font-size:1.4rem; font-weight:500; color:var(--white); margin-bottom:0.5rem; }
    .abody__content :global(.svc-block-title .n) { color:var(--gold); font-size:0.95rem; font-style:italic; margin-right:0.5rem; }
    .abody__content :global(.svc-list) { list-style:none; display:flex; flex-direction:column; gap:0.9rem; margin:1.5rem 0 0.5rem; }
    .abody__content :global(.svc-list li) { position:relative; padding-left:1.75rem; color:var(--white-dim); font-size:0.97rem; line-height:1.6; }
    .abody__content :global(.svc-list li::before) { content:''; position:absolute; left:0; top:0.6rem; width:8px; height:8px; border:1px solid var(--gold); transform:rotate(45deg); }
    .abody__content :global(.svc-list li strong) { color:var(--white); font-weight:500; }

    /* CARD DO ADVOGADO */
    .abody__side { position:sticky; top:110px; }
    .lawyer { background:var(--dark-2); border:1px solid var(--gold-border); padding:1.5rem; }
    .lawyer__frame { position:relative; margin-bottom:1.5rem; }
    .lawyer__frame::before { content:''; position:absolute; inset:-0.75rem -0.75rem 0.75rem 0.75rem; border:1px solid var(--gold-border); }
    .lawyer__img { position:relative; z-index:1; width:100%; aspect-ratio:4/5; object-fit:cover; object-position:top center; filter:grayscale(1) contrast(1.05) brightness(1.03) sepia(0.26) hue-rotate(-10deg); }
    .lawyer__meta .label { display:block; margin-bottom:0.6rem; }
    .lawyer__name { font-family:var(--font-display); font-size:1.7rem; font-weight:500; line-height:1.1; }
    .lawyer__role { color:var(--gold); font-size:0.85rem; letter-spacing:0.04em; margin-top:0.2rem; }
    .lawyer__oab { color:var(--white-dim); font-size:0.78rem; letter-spacing:0.08em; margin-top:0.3rem; }
    .lawyer__bio { color:var(--white-dim); font-size:0.9rem; line-height:1.7; margin:1rem 0 1.3rem; }

    @media (max-width:900px) {
      .abody__grid { grid-template-columns:1fr; gap:3rem; }
      .abody__side { position:static; }
      .lawyer { display:grid; grid-template-columns:1fr 1.4fr; gap:1.5rem; align-items:center; }
      .lawyer__frame { margin-bottom:0; }
    }
    @media (max-width:560px) {
      .ah { padding:9rem 0 4rem; }
      .lawyer { grid-template-columns:1fr; }
    }
  </style>
</Layout>
