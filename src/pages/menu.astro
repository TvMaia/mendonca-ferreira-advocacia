---
// /menu — Hub de links (destino do QR Code do cartao). MODELO editavel.
// URL permanente: https://mendoncaferreiraadv.com.br/menu
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const links = [
  { label: 'Áreas de Atuação', desc: 'Defesa criminal estratégica', href: '/#areas' },
  { label: 'O Escritório', desc: 'Quem somos e como atuamos', href: '/#escritorio' },
  { label: 'Fale no WhatsApp', desc: 'Atendimento direto', href: 'https://wa.me/5511953545061' },
  { label: 'E-mail', desc: 'mailson@mendoncaferreiraadv.com.br', href: 'mailto:mailson@mendoncaferreiraadv.com.br' },
  { label: 'Instagram', desc: '@mendoncaferreiraadv', href: '#' },
  { label: 'Como Chegar', desc: 'Localização do escritório', href: '#' },
];
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Mendonça & Ferreira Advocacia — links e contato." />
  <meta name="robots" content="noindex, follow" />
  <title>Mendonça & Ferreira Advocacia | Contato</title>
  <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --gold: #C9A84C;
      --gold-light: #E8C97A;
      --black: #0A0A0A;
      --dark: #121110;
      --white: #F5F0E8;
      --white-dim: rgba(245,240,232,0.60);
      --border: rgba(201,168,76,0.22);
      --font-display: 'Cormorant Garamond', Georgia, serif;
      --font-body: 'Jost', sans-serif;
      --ease: cubic-bezier(0.25,0.46,0.45,0.94);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 16px; -webkit-font-smoothing: antialiased; }
    body {
      font-family: var(--font-body);
      color: var(--white);
      background: var(--black);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      background-image:
        radial-gradient(120% 60% at 50% -10%, rgba(201,168,76,0.12), transparent 60%),
        radial-gradient(80% 50% at 50% 110%, rgba(201,168,76,0.06), transparent 60%);
    }
    .wrap {
      width: 100%;
      max-width: 460px;
      padding: 3.2rem 1.6rem 2.4rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      animation: rise 0.7s var(--ease) both;
    }
    @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

    .brand { text-align: center; margin-bottom: 2.4rem; }
    .brand__mf {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 3.6rem;
      line-height: 1;
      letter-spacing: 0.04em;
      color: var(--gold);
    }
    .brand__rule {
      width: 46px; height: 1px;
      background: var(--gold);
      opacity: 0.5;
      margin: 1rem auto 0.95rem;
    }
    .brand__name {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: 1.28rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--white);
    }
    .brand__tag {
      font-family: var(--font-body);
      font-weight: 300;
      font-size: 0.66rem;
      letter-spacing: 0.42em;
      text-transform: uppercase;
      color: var(--gold-light);
      margin-top: 0.5rem;
    }

    .links { width: 100%; display: flex; flex-direction: column; gap: 0.85rem; }
    .link {
      display: flex; align-items: center; gap: 0.9rem;
      padding: 1rem 1.15rem;
      border: 1px solid var(--border);
      border-radius: 3px;
      background: rgba(245,240,232,0.015);
      color: var(--white);
      text-decoration: none;
      transition: border-color 0.4s var(--ease), background 0.4s var(--ease), transform 0.3s var(--ease);
    }
    .link:hover, .link:focus-visible {
      border-color: var(--gold);
      background: rgba(201,168,76,0.07);
      transform: translateY(-1px);
    }
    .link__body { flex: 1; min-width: 0; }
    .link__label {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1.18rem;
      letter-spacing: 0.01em;
      line-height: 1.15;
    }
    .link__desc {
      font-size: 0.72rem;
      font-weight: 300;
      letter-spacing: 0.04em;
      color: var(--white-dim);
      margin-top: 0.15rem;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .link__arrow { color: var(--gold); flex-shrink: 0; opacity: 0.7; transition: transform 0.3s var(--ease); }
    .link:hover .link__arrow { transform: translateX(3px); opacity: 1; }

    .foot {
      margin-top: 2.6rem;
      font-size: 0.6rem;
      font-weight: 300;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(245,240,232,0.32);
      text-align: center;
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
    }
  </style>
</head>
<body>
  <main class="wrap">
    <header class="brand">
      <div class="brand__mf">MF</div>
      <div class="brand__rule"></div>
      <div class="brand__name">Mendonça &amp; Ferreira</div>
      <div class="brand__tag">Advocacia</div>
    </header>

    <nav class="links">
      {links.map((l) => (
        <a class="link" href={l.href}>
          <div class="link__body">
            <div class="link__label">{l.label}</div>
            <div class="link__desc">{l.desc}</div>
          </div>
          <svg class="link__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      ))}
    </nav>

    <p class="foot">Mendonça &amp; Ferreira Advocacia</p>
  </main>
</body>
</html>
