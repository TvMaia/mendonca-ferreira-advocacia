---
// Mendonça & Ferreira Advocacia - Landing Page
// Estilo: Luxury / Editorial / Dark & Gold — v2.0
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Mendonça & Ferreira Advocacia Criminal — Defesa estratégica para crimes empresariais, ambientais e complexos. Excelência jurídica com discrição e resultado." />
  <meta name="robots" content="index, follow" />
  <title>Mendonça & Ferreira Advocacia | Defesa Criminal Estratégica</title>

  <!-- Open Graph -->
  <meta property="og:title" content="Mendonça & Ferreira Advocacia" />
  <meta property="og:description" content="Defesa criminal de alto nível para casos complexos. Crimes empresariais, ambientais e tributários." />
  <meta property="og:image" content={`${import.meta.env.BASE_URL}og-image.jpg`} />
  <meta property="og:type" content="website" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <style>
    /* ═══════════════════════════════════════
       DESIGN TOKENS
    ═══════════════════════════════════════ */
    :root {
      --gold:        #C9A84C;
      --gold-light:  #E8C97A;
      --gold-dark:   #8B6914;
      --black:       #0A0A0A;
      --dark:        #111111;
      --dark-2:      #161616;
      --dark-3:      #1E1C1A;
      --dark-4:      #252320;
      --white:       #F5F0E8;
      --white-dim:   rgba(245, 240, 232, 0.65);
      --white-faint: rgba(245, 240, 232, 0.12);
      --gold-rgba:   rgba(201, 168, 76, 0.15);
      --gold-border: rgba(201, 168, 76, 0.25);

      --font-display: 'Cormorant Garamond', Georgia, serif;
      --font-body:    'Jost', sans-serif;

      --max-w: 1240px;
      --ease:  cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    /* ═══════════════════════════════════════
       RESET & BASE
    ═══════════════════════════════════════ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; font-size: 16px; }

    body {
      background: var(--black);
      color: var(--white);
      font-family: var(--font-body);
      font-weight: 300;
      line-height: 1.7;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    img { display: block; max-width: 100%; }
    a { color: inherit; text-decoration: none; }

    /* ═══════════════════════════════════════
       NOISE TEXTURE OVERLAY
    ═══════════════════════════════════════ */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E");
      opacity: 0.028;
      pointer-events: none;
      z-index: 9999;
    }

    /* ═══════════════════════════════════════
       PAGE LOADER
    ═══════════════════════════════════════ */
    #loader {
      position: fixed;
      inset: 0;
      background: var(--black);
      z-index: 99998;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      transition: opacity 0.7s var(--ease), visibility 0.7s;
    }
    #loader.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .loader__mf {
      font-family: var(--font-display);
      font-size: 5rem;
      font-weight: 600;
      color: var(--gold);
      letter-spacing: 0.08em;
      line-height: 1;
      animation: loaderFadeIn 0.9s var(--ease) both;
    }
    .loader__bar {
      width: 0;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--gold), transparent);
      animation: loaderBar 0.8s var(--ease) 0.4s both;
    }
    .loader__label {
      font-family: var(--font-body);
      font-size: 0.6rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--white-dim);
      opacity: 0;
      animation: loaderFadeIn 0.6s var(--ease) 0.6s both;
    }
    @keyframes loaderFadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes loaderBar {
      to { width: 80px; }
    }

    /* ═══════════════════════════════════════
       SCROLL PROGRESS BAR
    ═══════════════════════════════════════ */
    #progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 2px;
      width: 0%;
      background: linear-gradient(to right, var(--gold-dark), var(--gold), var(--gold-light));
      z-index: 99999;
      transition: width 0.08s linear;
    }

    /* ═══════════════════════════════════════
       CUSTOM CURSOR
    ═══════════════════════════════════════ */
    @media (hover: hover) and (pointer: fine) {
      body { cursor: none; }
      a, button, [role="button"], .area-card, .faq__question, .result-card { cursor: none; }

      .cursor {
        position: fixed;
        width: 34px;
        height: 34px;
        border: 1px solid rgba(201, 168, 76, 0.55);
        border-radius: 50%;
        pointer-events: none;
        z-index: 99997;
        top: 0; left: 0;
        transform: translate(-50%, -50%);
        transition: transform 0.18s var(--ease), width 0.3s var(--ease), height 0.3s var(--ease), background 0.3s, border-color 0.3s;
        will-change: transform;
      }
      .cursor.hovering {
        width: 52px;
        height: 52px;
        background: rgba(201, 168, 76, 0.07);
        border-color: rgba(201, 168, 76, 0.8);
      }
      .cursor-dot {
        position: fixed;
        width: 4px;
        height: 4px;
        background: var(--gold);
        border-radius: 50%;
        pointer-events: none;
        z-index: 99997;
        top: 0; left: 0;
        transform: translate(-50%, -50%);
        will-change: transform;
        transition: transform 0.04s;
      }
    }

    /* ═══════════════════════════════════════
       UTILITY CLASSES
    ═══════════════════════════════════════ */
    .container {
      width: 100%;
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 2rem;
    }

    .gold { color: var(--gold); }
    .gold-line {
      display: block;
      width: 48px;
      height: 1px;
      background: var(--gold);
      margin-bottom: 1.5rem;
    }

    .label {
      font-family: var(--font-body);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      padding: 1rem 2.25rem;
      font-family: var(--font-body);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      border: 1px solid var(--gold);
      color: var(--gold);
      background: transparent;
      cursor: pointer;
      transition: background 0.3s var(--ease), color 0.3s var(--ease);
      position: relative;
      overflow: hidden;
    }
    .btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--gold);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s var(--ease);
      z-index: 0;
    }
    .btn:hover::before { transform: scaleX(1); }
    .btn:hover { color: var(--black); }
    .btn span, .btn svg { position: relative; z-index: 1; }

    .btn-filled {
      background: var(--gold);
      color: var(--black);
    }
    .btn-filled::before { background: var(--gold-light); }
    .btn-filled:hover { color: var(--black); }

    /* ═══════════════════════════════════════
       SCROLL REVEAL — BASE & VARIANTS
    ═══════════════════════════════════════ */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.85s var(--ease), transform 0.85s var(--ease);
    }
    .reveal-left {
      opacity: 0;
      transform: translateX(-36px);
      transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
    }
    .reveal-right {
      opacity: 0;
      transform: translateX(36px);
      transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
    }
    .reveal-scale {
      opacity: 0;
      transform: scale(0.93);
      transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
    }
    .reveal.visible,
    .reveal-left.visible,
    .reveal-right.visible,
    .reveal-scale.visible {
      opacity: 1;
      transform: none;
    }
    .reveal-delay-1 { transition-delay: 0.1s; }
    .reveal-delay-2 { transition-delay: 0.2s; }
    .reveal-delay-3 { transition-delay: 0.3s; }
    .reveal-delay-4 { transition-delay: 0.4s; }
    .reveal-delay-5 { transition-delay: 0.5s; }

    /* ═══════════════════════════════════════
       NAVIGATION
    ═══════════════════════════════════════ */
    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 1.5rem 0;
      transition: background 0.4s var(--ease), padding 0.4s var(--ease), backdrop-filter 0.4s;
    }
    .nav.scrolled {
      background: rgba(10, 10, 10, 0.92);
      backdrop-filter: blur(16px);
      padding: 1rem 0;
      border-bottom: 1px solid var(--gold-border);
    }
    .nav__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .nav__logo {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
    }
    .nav__logo-mf {
      font-family: var(--font-display);
      font-size: 1.6rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      color: var(--gold);
      line-height: 1;
    }
    .nav__logo-name {
      font-family: var(--font-display);
      font-size: 0.72rem;
      font-weight: 400;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--white-dim);
    }
    .nav__links {
      display: flex;
      gap: 2.5rem;
      list-style: none;
    }
    .nav__links a {
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--white-dim);
      transition: color 0.3s;
      position: relative;
    }
    .nav__links a::after {
      content: '';
      position: absolute;
      bottom: -3px;
      left: 0;
      width: 0;
      height: 1px;
      background: var(--gold);
      transition: width 0.3s var(--ease);
    }
    .nav__links a:hover { color: var(--gold); }
    .nav__links a:hover::after { width: 100%; }
    .nav__cta {
      font-size: 0.68rem;
      font-weight: 500;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 0.65rem 1.5rem;
      border: 1px solid var(--gold);
      color: var(--gold);
      transition: background 0.3s, color 0.3s;
    }
    .nav__cta:hover {
      background: var(--gold);
      color: var(--black);
    }
    .nav__hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 4px;
    }
    .nav__hamburger span {
      display: block;
      width: 24px;
      height: 1px;
      background: var(--gold);
      transition: all 0.3s;
    }
    .nav__hamburger.active span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .nav__hamburger.active span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .nav__hamburger.active span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

    /* ═══════════════════════════════════════
       HERO
    ═══════════════════════════════════════ */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: flex-end;
      padding-bottom: 8rem;
      overflow: hidden;
    }

    .hero__bg {
      position: absolute;
      inset: 0;
      /* background definido via inline style para suportar base path */
      background-size: cover;
      background-position: center top;
      transform: scale(1.05);
      animation: heroZoom 12s var(--ease) forwards;
    }
    @keyframes heroZoom {
      to { transform: scale(1); }
    }

    .hero__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(10,10,10,0.3) 0%,
        rgba(10,10,10,0.5) 35%,
        rgba(10,10,10,0.88) 75%,
        rgba(10,10,10,1) 100%
      );
    }
    .hero__overlay::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 80% 60% at 20% 80%, rgba(201,168,76,0.06), transparent);
    }

    .hero__gold-line {
      position: absolute;
      left: 0;
      top: 0;
      width: 3px;
      height: 60%;
      background: linear-gradient(to bottom, transparent, var(--gold), transparent);
      animation: goldLineIn 1.8s var(--ease) 0.5s both;
    }
    .hero__h-line {
      position: absolute;
      bottom: 7rem;
      left: 0;
      width: 0;
      height: 1px;
      background: linear-gradient(to right, var(--gold), rgba(201,168,76,0.3), transparent);
      animation: heroHLine 1.4s var(--ease) 1.3s both;
    }
    @keyframes goldLineIn {
      from { height: 0; opacity: 0; }
      to { height: 60%; opacity: 1; }
    }
    @keyframes heroHLine {
      to { width: 35%; }
    }

    .hero__content {
      position: relative;
      z-index: 2;
      max-width: 820px;
    }

    .hero__tag {
      display: inline-flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
      animation: fadeUp 1s var(--ease) 0.4s both;
    }
    .hero__tag::before {
      content: '';
      display: block;
      width: 32px;
      height: 1px;
      background: var(--gold);
    }

    .hero__headline {
      font-family: var(--font-display);
      font-size: clamp(3rem, 7vw, 6.5rem);
      font-weight: 300;
      line-height: 1.05;
      letter-spacing: -0.01em;
      margin-bottom: 1.5rem;
      animation: fadeUp 1s var(--ease) 0.6s both;
    }
    .hero__headline em {
      font-style: italic;
      color: var(--gold);
    }

    .hero__sub {
      font-size: 1.05rem;
      font-weight: 300;
      color: var(--white-dim);
      max-width: 540px;
      margin-bottom: 3rem;
      animation: fadeUp 1s var(--ease) 0.8s both;
    }

    .hero__actions {
      display: flex;
      gap: 1.25rem;
      flex-wrap: wrap;
      animation: fadeUp 1s var(--ease) 1s both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .hero__scroll {
      position: absolute;
      bottom: 2.5rem;
      right: 3rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      animation: fadeUp 1s var(--ease) 1.4s both;
    }
    .hero__scroll span {
      writing-mode: vertical-rl;
      font-size: 0.62rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--white-dim);
    }
    .hero__scroll-line {
      width: 1px;
      height: 48px;
      background: linear-gradient(to bottom, var(--gold), transparent);
      animation: scrollPulse 2s ease infinite;
    }
    @keyframes scrollPulse {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.3; }
    }

    /* ═══════════════════════════════════════
       CREDENCIAL STRIP
    ═══════════════════════════════════════ */
    .strip {
      border-top: 1px solid var(--gold-border);
      border-bottom: 1px solid var(--gold-border);
      background: var(--dark-2);
      padding: 1.5rem 0;
      overflow: hidden;
    }
    .strip__inner {
      display: flex;
      align-items: center;
      gap: 4rem;
      animation: stripScroll 30s linear infinite;
      white-space: nowrap;
    }
    .strip:hover .strip__inner {
      animation-play-state: paused;
    }
    @keyframes stripScroll {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
    .strip__item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.68rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--white-dim);
      flex-shrink: 0;
      transition: color 0.3s;
    }
    .strip:hover .strip__item:hover {
      color: var(--gold);
    }
    .strip__item::before {
      content: '◆';
      color: var(--gold);
      font-size: 0.4rem;
    }

    /* ═══════════════════════════════════════
       ABOUT / POSICIONAMENTO
    ═══════════════════════════════════════ */
    .about {
      padding: 10rem 0;
      position: relative;
    }
    .about::before {
      content: 'MF';
      position: absolute;
      right: -2%;
      top: 50%;
      transform: translateY(-50%);
      font-family: var(--font-display);
      font-size: clamp(14rem, 22vw, 22rem);
      font-weight: 700;
      color: var(--white-faint);
      pointer-events: none;
      line-height: 1;
      letter-spacing: -0.05em;
    }
    .about__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
      align-items: center;
    }
    .about__image-wrap {
      position: relative;
    }
    .about__image-wrap::before {
      content: '';
      position: absolute;
      inset: -1.5rem -1.5rem 1.5rem 1.5rem;
      border: 1px solid var(--gold-border);
      z-index: 0;
    }
    .about__image {
      width: 100%;
      aspect-ratio: 4/5;
      object-fit: cover;
      object-position: top center;
      filter: grayscale(20%);
      position: relative;
      z-index: 1;
    }
    .about__image-placeholder {
      width: 100%;
      aspect-ratio: 4/5;
      background: linear-gradient(145deg, var(--dark-3) 0%, var(--dark-4) 60%, #1a1814 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 1;
      overflow: hidden;
    }
    .about__image-placeholder::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        repeating-linear-gradient(
          -45deg,
          transparent,
          transparent 20px,
          rgba(201,168,76,0.025) 20px,
          rgba(201,168,76,0.025) 21px
        );
    }
    .about__image-placeholder::after {
      content: '';
      position: absolute;
      inset: 2rem;
      border: 1px solid rgba(201,168,76,0.15);
    }
    .placeholder-inner {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      text-align: center;
    }
    .placeholder-inner svg {
      opacity: 0.2;
      color: var(--gold);
    }
    .placeholder-inner .ph-label {
      font-family: var(--font-display);
      font-size: 0.8rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--white-dim);
      opacity: 0.6;
    }
    .placeholder-inner .ph-size {
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      color: var(--gold);
      opacity: 0.5;
    }
    .about__badge {
      position: absolute;
      bottom: -2rem;
      right: -2rem;
      width: 9rem;
      height: 9rem;
      background: var(--gold);
      color: var(--black);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      z-index: 2;
    }
    .about__badge-num {
      font-family: var(--font-display);
      font-size: 2.8rem;
      font-weight: 600;
      line-height: 1;
    }
    .about__badge-text {
      font-size: 0.58rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      line-height: 1.3;
    }
    .about__eyebrow {
      margin-bottom: 1rem;
    }
    .about__heading {
      font-family: var(--font-display);
      font-size: clamp(2.2rem, 4vw, 3.4rem);
      font-weight: 400;
      line-height: 1.15;
      margin-bottom: 2rem;
    }
    .about__heading em {
      font-style: italic;
      color: var(--gold);
    }
    .about__text {
      color: var(--white-dim);
      margin-bottom: 1.25rem;
      font-size: 0.97rem;
    }
    .about__divider {
      width: 100%;
      height: 1px;
      background: var(--gold-border);
      margin: 2.5rem 0;
    }
    .about__stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .about__stat-num {
      font-family: var(--font-display);
      font-size: 2.6rem;
      font-weight: 500;
      color: var(--gold);
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    .about__stat-label {
      font-size: 0.72rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--white-dim);
      margin-top: 0.3rem;
    }

    /* ═══════════════════════════════════════
       AREAS DE ATUAÇÃO
    ═══════════════════════════════════════ */
    .areas {
      padding: 8rem 0;
      background: var(--dark-2);
      position: relative;
    }
    .areas::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--gold), transparent);
    }
    .areas__header {
      text-align: center;
      margin-bottom: 5rem;
    }
    .areas__heading {
      font-family: var(--font-display);
      font-size: clamp(2.2rem, 4vw, 3.2rem);
      font-weight: 400;
      margin-top: 1rem;
      line-height: 1.2;
    }
    .areas__heading em { font-style: italic; color: var(--gold); }

    .areas__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5px;
      background: var(--gold-border);
      border: 1.5px solid var(--gold-border);
    }

    .area-card {
      background: var(--dark);
      padding: 3rem 2.5rem;
      position: relative;
      overflow: hidden;
      transition: background 0.4s var(--ease), transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
      cursor: default;
    }
    .area-card::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--gold);
      transform: scaleX(0);
      transition: transform 0.4s var(--ease);
    }
    .area-card:hover {
      background: var(--dark-3);
      transform: translateY(-3px);
      box-shadow: 0 12px 40px rgba(201, 168, 76, 0.07);
    }
    .area-card:hover::before { transform: scaleX(1); }

    .area-card__num {
      position: absolute;
      top: 1.25rem;
      right: 1.75rem;
      font-family: var(--font-display);
      font-size: 4.5rem;
      font-weight: 700;
      color: rgba(245, 240, 232, 0.05);
      line-height: 1;
      pointer-events: none;
      transition: color 0.4s var(--ease);
      letter-spacing: -0.02em;
    }
    .area-card:hover .area-card__num {
      color: rgba(201, 168, 76, 0.09);
    }
    .area-card__icon {
      width: 48px;
      height: 48px;
      margin-bottom: 1.75rem;
      color: var(--gold);
      opacity: 0.8;
      transition: opacity 0.3s, transform 0.4s var(--ease);
    }
    .area-card:hover .area-card__icon {
      opacity: 1;
      transform: translateY(-2px);
    }
    .area-card__tag {
      font-size: 0.6rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 0.75rem;
      font-weight: 500;
    }
    .area-card__title {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 500;
      margin-bottom: 1rem;
      line-height: 1.2;
    }
    .area-card__text {
      font-size: 0.88rem;
      color: var(--white-dim);
      line-height: 1.75;
    }
    .area-card--highlight {
      background: var(--dark-3);
    }
    .area-card--highlight .area-card__tag {
      background: var(--gold-rgba);
      display: inline-block;
      padding: 0.2rem 0.8rem;
      border: 1px solid var(--gold-border);
    }

    /* ═══════════════════════════════════════
       DIFERENCIAIS
    ═══════════════════════════════════════ */
    .diff {
      padding: 9rem 0;
      position: relative;
      overflow: hidden;
    }
    .diff__bg-text {
      position: absolute;
      left: -3%;
      top: 50%;
      transform: translateY(-50%);
      font-family: var(--font-display);
      font-size: clamp(12rem, 18vw, 18rem);
      font-weight: 700;
      color: var(--white-faint);
      pointer-events: none;
      line-height: 1;
      white-space: nowrap;
    }
    .diff__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: center;
      position: relative;
    }
    .diff__heading {
      font-family: var(--font-display);
      font-size: clamp(2.2rem, 4vw, 3.4rem);
      font-weight: 400;
      line-height: 1.15;
      margin-top: 1rem;
      margin-bottom: 2.5rem;
    }
    .diff__heading em { font-style: italic; color: var(--gold); }
    .diff__list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }
    .diff__item {
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
      padding-bottom: 1.75rem;
      border-bottom: 1px solid var(--gold-border);
      transition: padding-left 0.3s var(--ease);
    }
    .diff__item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
    .diff__num {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 300;
      color: var(--gold);
      opacity: 0.5;
      line-height: 1;
      flex-shrink: 0;
      width: 2.5rem;
    }
    .diff__item-title {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 500;
      margin-bottom: 0.4rem;
    }
    .diff__item-text {
      font-size: 0.88rem;
      color: var(--white-dim);
    }
    .diff__visual {
      position: relative;
    }
    .diff__image {
      width: 100%;
      aspect-ratio: 3/4;
      object-fit: cover;
      filter: grayscale(30%);
    }
    .diff__image-placeholder {
      width: 100%;
      aspect-ratio: 3/4;
      background: linear-gradient(145deg, var(--dark-3) 0%, var(--dark-4) 60%, #1a1814 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }
    .diff__image-placeholder::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        repeating-linear-gradient(
          -45deg,
          transparent,
          transparent 20px,
          rgba(201,168,76,0.025) 20px,
          rgba(201,168,76,0.025) 21px
        );
    }
    .diff__image-placeholder::after {
      content: '';
      position: absolute;
      inset: 2rem;
      border: 1px solid rgba(201,168,76,0.15);
    }
    .diff__quote-box {
      position: absolute;
      bottom: -2.5rem;
      left: -2.5rem;
      background: var(--gold);
      color: var(--black);
      padding: 2rem;
      max-width: 280px;
    }
    .diff__quote-text {
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-style: italic;
      font-weight: 500;
      line-height: 1.4;
      margin-bottom: 0.75rem;
    }
    .diff__quote-attr {
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 500;
    }

    /* ═══════════════════════════════════════
       PROCESSO
    ═══════════════════════════════════════ */
    .process {
      padding: 8rem 0;
      background: var(--dark-2);
      position: relative;
    }
    .process::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--gold), transparent);
    }
    .process__header {
      text-align: center;
      margin-bottom: 5rem;
    }
    .process__heading {
      font-family: var(--font-display);
      font-size: clamp(2.2rem, 4vw, 3.2rem);
      font-weight: 400;
      margin-top: 1rem;
    }
    .process__heading em { font-style: italic; color: var(--gold); }

    .process__steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      position: relative;
    }
    .process__steps::before {
      content: '';
      position: absolute;
      top: 2rem;
      left: 12.5%;
      right: 12.5%;
      height: 1px;
      background: var(--gold-border);
      z-index: 0;
    }

    .process__step {
      padding: 0 1.5rem;
      text-align: center;
      position: relative;
      z-index: 1;
    }
    .process__step-dot {
      width: 4rem;
      height: 4rem;
      border: 1px solid var(--gold);
      background: var(--dark-2);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 2rem;
      font-family: var(--font-display);
      font-size: 1.3rem;
      font-weight: 500;
      color: var(--gold);
      transition: background 0.4s var(--ease), color 0.4s var(--ease), box-shadow 0.4s var(--ease);
    }
    .process__step-dot.active {
      background: var(--gold);
      color: var(--black);
      box-shadow: 0 0 24px rgba(201, 168, 76, 0.35);
    }
    .process__step:hover .process__step-dot {
      background: var(--gold);
      color: var(--black);
      box-shadow: 0 0 20px rgba(201, 168, 76, 0.3);
    }
    .process__step-title {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 500;
      margin-bottom: 0.75rem;
    }
    .process__step-text {
      font-size: 0.85rem;
      color: var(--white-dim);
      line-height: 1.7;
    }

    /* ═══════════════════════════════════════
       TESTIMONIALS / CASOS
    ═══════════════════════════════════════ */
    .results {
      padding: 9rem 0;
      position: relative;
      overflow: hidden;
    }
    .results__header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 4rem;
    }
    .results__heading {
      font-family: var(--font-display);
      font-size: clamp(2.2rem, 4vw, 3.2rem);
      font-weight: 400;
      margin-top: 1rem;
    }
    .results__heading em { font-style: italic; color: var(--gold); }
    .results__note {
      font-size: 0.78rem;
      color: var(--white-dim);
      max-width: 280px;
      text-align: right;
      line-height: 1.6;
    }

    .results__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .result-card {
      background: var(--dark-2);
      border: 1px solid var(--gold-border);
      padding: 2.5rem;
      position: relative;
      transition: border-color 0.3s, transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
    }
    .result-card:hover {
      border-color: var(--gold);
      transform: translateY(-4px);
      box-shadow: 0 10px 36px rgba(201, 168, 76, 0.07);
    }
    .result-card::before {
      content: '"';
      position: absolute;
      top: 1.5rem;
      right: 2rem;
      font-family: var(--font-display);
      font-size: 5rem;
      color: var(--gold);
      opacity: 0.12;
      line-height: 1;
    }
    .result-card__type {
      font-size: 0.62rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 1.25rem;
      font-weight: 500;
    }
    .result-card__outcome {
      font-family: var(--font-display);
      font-size: 1.35rem;
      font-weight: 500;
      line-height: 1.3;
      margin-bottom: 1rem;
    }
    .result-card__text {
      font-size: 0.88rem;
      color: var(--white-dim);
      margin-bottom: 2rem;
      line-height: 1.7;
    }
    .result-card__client {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--gold-border);
    }
    .result-card__avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--gold-rgba);
      border: 1px solid var(--gold-border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-size: 0.9rem;
      color: var(--gold);
    }
    .result-card__name {
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.05em;
    }
    .result-card__role {
      font-size: 0.7rem;
      color: var(--white-dim);
      letter-spacing: 0.05em;
    }

    /* ═══════════════════════════════════════
       CTA CENTRAL
    ═══════════════════════════════════════ */
    .cta-section {
      padding: 8rem 0;
      background: var(--dark-3);
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .cta-section::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 40% at 50% 50%, var(--gold-rgba), transparent);
      pointer-events: none;
    }
    .cta-section::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--gold), transparent);
    }
    .cta__corner {
      position: absolute;
      width: 60px;
      height: 60px;
      opacity: 0.3;
    }
    .cta__corner--tl { top: 2rem; left: 2rem; border-top: 1px solid var(--gold); border-left: 1px solid var(--gold); }
    .cta__corner--tr { top: 2rem; right: 2rem; border-top: 1px solid var(--gold); border-right: 1px solid var(--gold); }
    .cta__corner--bl { bottom: 2rem; left: 2rem; border-bottom: 1px solid var(--gold); border-left: 1px solid var(--gold); }
    .cta__corner--br { bottom: 2rem; right: 2rem; border-bottom: 1px solid var(--gold); border-right: 1px solid var(--gold); }
    .cta-section .gold-line {
      margin: 0 auto 1.5rem;
    }
    .cta__heading {
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      font-weight: 400;
      line-height: 1.1;
      margin-bottom: 1.5rem;
    }
    .cta__heading em { font-style: italic; color: var(--gold); }
    .cta__sub {
      font-size: 1rem;
      color: var(--white-dim);
      max-width: 540px;
      margin: 0 auto 3rem;
      line-height: 1.75;
    }
    .cta__actions {
      display: flex;
      gap: 1.25rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .cta__disclaimer {
      margin-top: 2rem;
      font-size: 0.72rem;
      color: var(--white-dim);
      opacity: 0.6;
      letter-spacing: 0.05em;
    }

    /* ═══════════════════════════════════════
       FAQ
    ═══════════════════════════════════════ */
    .faq {
      padding: 8rem 0;
      background: var(--dark-2);
    }
    .faq__grid {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 6rem;
      align-items: flex-start;
    }
    .faq__heading {
      font-family: var(--font-display);
      font-size: clamp(2rem, 3.5vw, 2.8rem);
      font-weight: 400;
      line-height: 1.2;
      margin-top: 1rem;
      position: sticky;
      top: 120px;
    }
    .faq__heading em { font-style: italic; color: var(--gold); }
    .faq__list {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .faq__item {
      border-bottom: 1px solid var(--gold-border);
      transition: padding-left 0.35s var(--ease), border-left 0.35s var(--ease);
    }
    .faq__item.open {
      padding-left: 1rem;
      border-left: 2px solid var(--gold);
    }
    .faq__question {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.75rem 0;
      cursor: pointer;
      gap: 1rem;
    }
    .faq__q-text {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 500;
      transition: color 0.3s;
    }
    .faq__item.open .faq__q-text {
      color: var(--gold);
    }
    .faq__icon {
      width: 24px;
      height: 24px;
      flex-shrink: 0;
      color: var(--gold);
      transition: transform 0.35s var(--ease);
    }
    .faq__item.open .faq__icon { transform: rotate(45deg); }
    .faq__answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.5s var(--ease), padding 0.3s;
    }
    .faq__item.open .faq__answer {
      max-height: 400px;
      padding-bottom: 1.75rem;
    }
    .faq__answer-text {
      font-size: 0.92rem;
      color: var(--white-dim);
      line-height: 1.8;
    }

    /* ═══════════════════════════════════════
       FOOTER
    ═══════════════════════════════════════ */
    .footer {
      background: var(--black);
      border-top: 1px solid var(--gold-border);
      padding: 5rem 0 2.5rem;
      position: relative;
      overflow: hidden;
    }
    .footer__watermark {
      position: absolute;
      bottom: -1rem;
      right: -1rem;
      font-family: var(--font-display);
      font-size: 12rem;
      font-weight: 700;
      color: rgba(245, 240, 232, 0.03);
      line-height: 1;
      pointer-events: none;
      letter-spacing: -0.05em;
    }
    .footer__grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 4rem;
      margin-bottom: 4rem;
      position: relative;
    }
    .footer__brand-mf {
      font-family: var(--font-display);
      font-size: 3rem;
      font-weight: 600;
      color: var(--gold);
      line-height: 1;
      margin-bottom: 0.25rem;
    }
    .footer__brand-name {
      font-family: var(--font-display);
      font-size: 0.8rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--white-dim);
      margin-bottom: 1.5rem;
    }
    .footer__brand-text {
      font-size: 0.88rem;
      color: var(--white-dim);
      line-height: 1.75;
      max-width: 320px;
      margin-bottom: 1.5rem;
    }
    .footer__social {
      display: flex;
      gap: 0.75rem;
    }
    .footer__social-link {
      width: 36px;
      height: 36px;
      border: 1px solid var(--gold-border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--white-dim);
      transition: border-color 0.3s, color 0.3s, background 0.3s;
    }
    .footer__social-link:hover {
      border-color: var(--gold);
      color: var(--gold);
      background: var(--gold-rgba);
    }
    .footer__col-title {
      font-size: 0.65rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 500;
      margin-bottom: 1.5rem;
    }
    .footer__links {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }
    .footer__links a {
      font-size: 0.88rem;
      color: var(--white-dim);
      transition: color 0.3s, padding-left 0.3s var(--ease);
      display: inline-block;
    }
    .footer__links a:hover {
      color: var(--gold);
      padding-left: 0.5rem;
    }
    .footer__contact-item {
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
      font-size: 0.85rem;
      color: var(--white-dim);
      margin-bottom: 0.85rem;
    }
    .footer__contact-item svg {
      flex-shrink: 0;
      margin-top: 2px;
      color: var(--gold);
    }
    .footer__bottom {
      border-top: 1px solid var(--gold-border);
      padding-top: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.75rem;
      color: var(--white-dim);
      opacity: 0.6;
      position: relative;
    }

    /* ═══════════════════════════════════════
       WHATSAPP FLOAT
    ═══════════════════════════════════════ */
    .wa-float {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      z-index: 200;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .wa-float__label {
      background: var(--dark-2);
      border: 1px solid var(--gold-border);
      padding: 0.5rem 1rem;
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--white-dim);
      opacity: 0;
      transform: translateX(10px);
      transition: opacity 0.3s, transform 0.3s;
      white-space: nowrap;
    }
    .wa-float:hover .wa-float__label {
      opacity: 1;
      transform: translateX(0);
    }
    .wa-float__btn {
      width: 56px;
      height: 56px;
      background: #25D366;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 20px rgba(37, 211, 102, 0.3);
      transition: transform 0.3s, box-shadow 0.3s;
      flex-shrink: 0;
      position: relative;
    }
    .wa-float__btn::before {
      content: '';
      position: absolute;
      inset: -8px;
      border-radius: 50%;
      border: 1px solid rgba(37, 211, 102, 0.4);
      animation: waPulse 2.2s ease infinite;
    }
    .wa-float__btn::after {
      content: '';
      position: absolute;
      inset: -16px;
      border-radius: 50%;
      border: 1px solid rgba(37, 211, 102, 0.2);
      animation: waPulse 2.2s ease 0.4s infinite;
    }
    @keyframes waPulse {
      0%   { transform: scale(1); opacity: 0.8; }
      100% { transform: scale(1.5); opacity: 0; }
    }
    .wa-float__btn:hover {
      transform: scale(1.08);
      box-shadow: 0 6px 28px rgba(37, 211, 102, 0.45);
    }
    .wa-float__btn:hover::before,
    .wa-float__btn:hover::after { animation-play-state: paused; opacity: 0; }
    .wa-float__btn svg { color: white; position: relative; z-index: 1; }

    /* ═══════════════════════════════════════
       MOBILE MENU
    ═══════════════════════════════════════ */
    .mobile-menu {
      position: fixed;
      inset: 0;
      background: var(--black);
      z-index: 99;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2.5rem;
      transform: translateX(100%);
      transition: transform 0.5s var(--ease);
    }
    .mobile-menu.open { transform: translateX(0); }
    .mobile-menu__close {
      position: absolute;
      top: 2rem;
      right: 2rem;
      width: 44px;
      height: 44px;
      border: 1px solid var(--gold-border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold);
      cursor: pointer;
