---
import Layout from '../layouts/Layout.astro';

const B = (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/');
const WA = '5511953545061';
const waLink = `https://api.whatsapp.com/send?phone=${WA}&text=${encodeURIComponent('Olá, vim pelo site da Mendonça & Ferreira Advocacia e gostaria de tirar uma dúvida.')}`;

const areas = [
  {
    slug: 'previdenciario', nome: 'Direito Previdenciário',
    desc: 'Aposentadorias, auxílios e benefícios do INSS — inclusive quando o pedido foi negado.',
    icon: '<path d="M12 2 4 6v6c0 5 3.4 8.4 8 10 4.6-1.6 8-5 8-10V6l-8-4z"/><path d="M9 12l2 2 4-4"/>'
  },
  {
    slug: 'trabalho', nome: 'Direito do Trabalho',
    desc: 'Verbas, horas extras, rescisão e a defesa dos seus direitos como trabalhador.',
    icon: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>'
  },
  {
    slug: 'civil', nome: 'Direito Civil',
    desc: 'Família, consumidor, cobranças e condomínio — os conflitos do dia a dia.',
    icon: '<path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>'
  },
  {
    slug: 'empresarial', nome: 'Direito Empresarial',
    desc: 'Contratos, sociedade e segurança jurídica para a sua empresa crescer tranquila.',
    icon: '<path d="M3 21h18M6 21V7l6-4 6 4v14"/><path d="M10 12h4M10 16h4"/>'
  },
  {
    slug: 'criminal', nome: 'Direito Criminal',
    desc: 'Defesa criminal estratégica e discreta, do inquérito aos tribunais superiores.',
    icon: '<path d="M12 3v18M8 21h8"/><path d="M12 6l-7 2M12 6l7 2"/><path d="M5 8l-2.5 5.5a2.8 2.8 0 0 0 5 0L5 8z"/><path d="M19 8l-2.5 5.5a2.8 2.8 0 0 0 5 0L19 8z"/>'
  },
];

const socios = [
  { nome: 'Dr. Mailson Mendonça Ferreira', area: 'Direito Criminal',            slug: 'criminal' },
  { nome: 'Dra. Gabriela Mendonça',        area: 'Previdenciário e Trabalhista', slug: 'previdenciario' },
  { nome: 'Dr. Ramyson Trajano',           area: 'Cível e Empresarial',          slug: 'civil' },
];
---

<Layout>
  <!-- HERO LIMPO -->
  <section class="hero">
    <div class="hero__bg" id="heroBg" style={`background-image: url('${B}images/hero-bg.jpg')`}></div>
    <div class="hero__overlay"></div>
    <div class="container hero__wrap">
      <span class="hero__kicker">Mendonça &amp; Ferreira Advocacia</span>
      <h1 class="hero__title">A sua causa<br>em <em>boas mãos.</em></h1>
      <p class="hero__sub">
        Direito previdenciário, trabalhista, cível, empresarial e criminal.
        Um escritório para acompanhar você do primeiro atendimento à decisão final.
      </p>
      <div class="hero__actions">
        <a href={waLink} class="btn btn-filled" target="_blank" rel="noopener">
          <span>Falar com o escritório</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="#areas" class="btn"><span>Ver áreas de atuação</span></a>
      </div>
    </div>
    <div class="hero__scroll">
      <div class="hero__scroll-line"></div>
      <span>Role</span>
    </div>
  </section>

  <!-- FAIXA INSTITUCIONAL ESTÁTICA (substitui o marquee poluído) -->
  <div class="band">
    <div class="container band__inner">
      <span>◆</span>
      <p>Atuação em todo o Brasil, Presencial e Online</p>
      <span>◆</span>
    </div>
  </div>

  <!-- ÁREAS (bloco principal) -->
  <section class="areas" id="areas">
    <div class="container">
      <div class="sec-head reveal">
        <span class="gold-line"></span>
        <span class="label">Áreas de Atuação</span>
        <h2 class="sec-title">Qual é o seu <em>problema jurídico?</em></h2>
      </div>
      <div class="areas__grid">
        {areas.map((a, i) => (
          <a href={`${B}${a.slug}/`} class="area-card reveal">
            <span class="area-card__num">{String(i + 1).padStart(2, '0')}</span>
            <svg class="area-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" set:html={a.icon}></svg>
            <h3 class="area-card__title">{a.nome}</h3>
            <p class="area-card__text">{a.desc}</p>
            <span class="area-card__go">Ver área
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
        <a href={waLink} target="_blank" rel="noopener" class="area-card area-card--cta reveal">
          <svg class="area-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <h3 class="area-card__title">Não sabe por onde começar?</h3>
          <p class="area-card__text">Conte a sua situação pelo WhatsApp. A gente entende o caso e indica o melhor caminho.</p>
          <span class="area-card__go">Falar agora
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- O ESCRITÓRIO -->
  <section class="about" id="escritorio">
    <div class="container">
      <div class="about__grid">
        <div class="about__visual reveal-left">
          <div class="about__frame"><img src={`${B}images/escritorio.jpg`} alt="Escritório Mendonça & Ferreira Advocacia" /></div>
        </div>
        <div>
          <span class="gold-line reveal"></span>
          <span class="label reveal">O Escritório</span>
          <h2 class="about__heading reveal reveal-delay-1">Um escritório,<br><em>especialistas dedicados.</em></h2>
          <p class="about__text reveal reveal-delay-2">
            A Mendonça &amp; Ferreira reúne advogados sócios, cada um à frente das áreas que domina.
            Na prática, isso significa que o seu caso é conduzido por quem vive aquele assunto todos os dias —
            e não por um generalista que faz um pouco de tudo.
          </p>
          <p class="about__text reveal reveal-delay-2">
            Nosso compromisso é com o atendimento próximo e a linguagem clara: você entende o que está
            acontecendo no seu processo, do começo ao fim, sem se perder no juridiquês.
          </p>

          <div class="socios reveal reveal-delay-3">
            {socios.map((s) => (
              <a href={`${B}${s.slug}/`} class="socio">
                <span class="socio__name">{s.nome}</span>
                <span class="socio__area">{s.area}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 6l6 6-6 6"/></svg>
              </a>
            ))}
          </div>

          <div class="about__stats reveal reveal-delay-4">
            <div>
              <div class="about__stat-num"><span data-count="5" data-suffix="">5</span></div>
              <div class="about__stat-label">Áreas de Atuação</div>
            </div>
            <div>
              <div class="about__stat-num">Brasil</div>
              <div class="about__stat-label">Atendimento em todo o país</div>
            </div>
            <div>
              <div class="about__stat-num">OAB</div>
              <div class="about__stat-label">Advogados regulares e atuantes</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMO ATUAMOS -->
  <section class="process" id="como">
    <div class="container">
      <div class="sec-head reveal">
        <span class="gold-line"></span>
        <span class="label">Como Atuamos</span>
        <h2 class="sec-title">Do primeiro contato ao <em>acompanhamento</em></h2>
      </div>
      <div class="process__steps">
        <div class="process__step reveal">
          <div class="process__step-dot" data-step="0">I</div>
          <h3 class="process__step-title">Contato</h3>
          <p class="process__step-text">Você fala com o escritório pelo WhatsApp e explica a sua situação, sem compromisso.</p>
        </div>
        <div class="process__step reveal reveal-delay-1">
          <div class="process__step-dot" data-step="1">II</div>
          <h3 class="process__step-title">Análise do caso</h3>
          <p class="process__step-text">O advogado da área avalia os detalhes e os documentos, e identifica os caminhos possíveis.</p>
        </div>
        <div class="process__step reveal reveal-delay-2">
          <div class="process__step-dot" data-step="2">III</div>
          <h3 class="process__step-title">Orientação clara</h3>
          <p class="process__step-text">Você recebe uma explicação transparente do que dá para fazer e do que esperar de cada opção.</p>
        </div>
        <div class="process__step reveal reveal-delay-3">
          <div class="process__step-dot" data-step="3">IV</div>
          <h3 class="process__step-title">Acompanhamento</h3>
          <p class="process__step-text">Seguindo com o escritório, você é mantido informado sobre cada passo até a decisão.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <div class="container">
      <div class="faq__grid">
        <div>
          <span class="gold-line reveal"></span>
          <span class="label reveal">Dúvidas Frequentes</span>
          <h2 class="faq__heading reveal reveal-delay-1">Perguntas que<br>todo cliente tem.<em> Respondemos.</em></h2>
        </div>
        <div class="faq__list reveal">
          <div class="faq__item">
            <div class="faq__question">
              <span class="faq__q-text">Como funciona o primeiro atendimento?</span>
              <svg class="faq__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </div>
            <div class="faq__answer"><p class="faq__answer-text">Você chama o escritório no WhatsApp e conta o que está acontecendo. A partir daí, o advogado da área analisa o seu caso e orienta os próximos passos, com clareza e sem compromisso.</p></div>
          </div>
          <div class="faq__item">
            <div class="faq__question">
              <span class="faq__q-text">O escritório atua em quais áreas?</span>
              <svg class="faq__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </div>
            <div class="faq__answer"><p class="faq__answer-text">Atuamos em cinco áreas: direito previdenciário, trabalhista, cível (família, consumidor, cobranças e condomínio), empresarial e criminal. Cada área é conduzida por um advogado sócio especializado nela.</p></div>
          </div>
          <div class="faq__item">
            <div class="faq__question">
              <span class="faq__q-text">Quanto custa? Como funcionam os honorários?</span>
              <svg class="faq__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </div>
            <div class="faq__answer"><p class="faq__answer-text">Depende da área e da complexidade do caso. Prezamos pela transparência total: você conhece a proposta de honorários com clareza antes de decidir qualquer coisa, sem surpresas.</p></div>
          </div>
          <div class="faq__item">
            <div class="faq__question">
              <span class="faq__q-text">Preciso ir até o escritório?</span>
              <svg class="faq__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </div>
            <div class="faq__answer"><p class="faq__answer-text">Não necessariamente. Atendemos presencialmente e também on-line, o que permite acompanhar clientes de outras cidades e estados. O primeiro contato costuma ser pelo WhatsApp.</p></div>
          </div>
          <div class="faq__item">
            <div class="faq__question">
              <span class="faq__q-text">O que eu conto para vocês fica em sigilo?</span>
              <svg class="faq__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </div>
            <div class="faq__answer"><p class="faq__answer-text">Sim. O sigilo entre advogado e cliente é protegido pelo Estatuto da OAB e pela Constituição. Tudo o que você compartilha, do primeiro WhatsApp em diante, está protegido por lei.</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="cta__corner cta__corner--tl"></div>
    <div class="cta__corner cta__corner--tr"></div>
    <div class="cta__corner cta__corner--bl"></div>
    <div class="cta__corner cta__corner--br"></div>
    <div class="container">
      <span class="gold-line reveal"></span>
      <span class="label reveal">Vamos conversar</span>
      <h2 class="cta__heading reveal reveal-delay-1">A sua dúvida merece<br><em>uma resposta séria.</em></h2>
      <p class="cta__sub reveal reveal-delay-2">Seja qual for a área, o primeiro passo é simples: uma conversa. Sem compromisso, com atendimento próximo e linguagem clara.</p>
      <div class="cta__actions reveal reveal-delay-3">
        <a href={waLink} class="btn btn-filled" target="_blank" rel="noopener">
          <span>Falar pelo WhatsApp</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="#areas" class="btn"><span>Ver áreas de atuação</span></a>
      </div>
      <p class="cta__disclaimer reveal">Conteúdo meramente informativo, conforme o Código de Ética e Disciplina da OAB.</p>
    </div>
  </section>

  <style>
    /* HERO */
    .hero { position:relative; min-height:100vh; display:flex; align-items:flex-end; padding-top:9rem; padding-bottom:8rem; overflow:hidden; }
    .hero__bg { position:absolute; inset:0; background-size:cover; background-position:center; transform:scale(1.05); filter:grayscale(0.6) contrast(1.05) sepia(0.16); animation:heroZoom 14s var(--ease) forwards; }
    @keyframes heroZoom { to { transform:scale(1); } }
    .hero__overlay { position:absolute; inset:0; background:linear-gradient(to bottom, rgba(10,10,10,0.45) 0%, rgba(10,10,10,0.6) 40%, rgba(10,10,10,0.9) 82%, rgba(10,10,10,1) 100%); }
    .hero__overlay::after { content:''; position:absolute; inset:0; background:radial-gradient(ellipse 80% 60% at 18% 78%, rgba(201,168,76,0.07), transparent); }
    .hero__wrap { position:relative; z-index:2; max-width:820px; }
    .hero__kicker { display:inline-block; font-size:0.72rem; font-weight:500; letter-spacing:0.28em; text-transform:uppercase; color:var(--gold); margin-bottom:1.8rem; padding-left:2.5rem; position:relative; animation:hUp 1s var(--ease) 0.4s both; }
    .hero__kicker::before { content:''; position:absolute; left:0; top:50%; width:32px; height:1px; background:var(--gold); }
    .hero__title { font-family:var(--font-display); font-size:clamp(3rem,7.5vw,6.5rem); font-weight:300; line-height:1.03; letter-spacing:-0.01em; margin-bottom:1.5rem; animation:hUp 1s var(--ease) 0.6s both; }
    .hero__title em { font-style:italic; color:var(--gold); }
    .hero__sub { font-size:1.15rem; font-weight:300; color:var(--white-dim); max-width:560px; margin-bottom:2.8rem; line-height:1.6; animation:hUp 1s var(--ease) 0.8s both; }
    .hero__actions { display:flex; gap:1.25rem; flex-wrap:wrap; animation:hUp 1s var(--ease) 1s both; }
    @keyframes hUp { from{opacity:0;transform:translateY(24px);} to{opacity:1;transform:translateY(0);} }
    .hero__scroll { position:absolute; bottom:2.5rem; right:3rem; display:flex; flex-direction:column; align-items:center; gap:0.5rem; animation:hUp 1s var(--ease) 1.4s both; }
    .hero__scroll span { writing-mode:vertical-rl; font-size:0.62rem; letter-spacing:0.25em; text-transform:uppercase; color:var(--white-dim); }
    .hero__scroll-line { width:1px; height:48px; background:linear-gradient(to bottom,var(--gold),transparent); animation:sPulse 2s ease infinite; }
    @keyframes sPulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

    /* BAND */
    .band { background:var(--dark-2); border-top:1px solid var(--gold-border); border-bottom:1px solid var(--gold-border); padding:1.15rem 0; }
    .band__inner { display:flex; align-items:center; justify-content:center; gap:1.5rem; }
    .band__inner p { font-size:0.72rem; letter-spacing:0.18em; text-transform:uppercase; color:var(--white-dim); text-align:center; }
    .band__inner span { color:var(--gold); font-size:0.5rem; }

    /* ÁREAS */
    .areas { padding:8rem 0; background:var(--black); position:relative; }
    .areas__grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5px; background:var(--gold-border); border:1.5px solid var(--gold-border); }
    .area-card { background:var(--dark); padding:3rem 2.5rem; position:relative; overflow:hidden; transition:background 0.4s var(--ease), transform 0.4s var(--ease); display:flex; flex-direction:column; min-height:270px; }
    .area-card::before { content:''; position:absolute; bottom:0; left:0; right:0; height:2px; background:var(--gold); transform:scaleX(0); transform-origin:left; transition:transform 0.4s var(--ease); }
    .area-card:hover { background:var(--dark-3); }
    .area-card:hover::before { transform:scaleX(1); }
    .area-card__num { position:absolute; top:1.25rem; right:1.75rem; font-family:var(--font-display); font-size:4rem; font-weight:700; color:rgba(245,240,232,0.05); line-height:1; transition:color 0.4s var(--ease); }
    .area-card:hover .area-card__num { color:rgba(201,168,76,0.10); }
    .area-card__icon { width:44px; height:44px; margin-bottom:1.5rem; color:var(--gold); opacity:0.85; transition:transform 0.4s var(--ease); }
    .area-card:hover .area-card__icon { transform:translateY(-3px); }
    .area-card__title { font-family:var(--font-display); font-size:1.5rem; font-weight:500; margin-bottom:0.8rem; line-height:1.2; }
    .area-card__text { font-size:0.9rem; color:var(--white-dim); line-height:1.7; flex-grow:1; }
    .area-card__go { display:inline-flex; align-items:center; gap:0.5rem; margin-top:1.5rem; font-size:0.68rem; font-weight:500; letter-spacing:0.16em; text-transform:uppercase; color:var(--gold); }
    .area-card__go svg { transition:transform 0.3s var(--ease); }
    .area-card:hover .area-card__go svg { transform:translateX(4px); }
    .area-card--cta { background:var(--dark-3); }
    .area-card--cta .area-card__icon { opacity:1; }

    /* ABOUT */
    .about { padding:9rem 0; position:relative; }
    .about::before { content:'MF'; position:absolute; right:4%; top:50%; transform:translateY(-50%); font-family:var(--font-display); font-size:clamp(12rem,20vw,20rem); font-weight:700; color:var(--white-faint); pointer-events:none; line-height:1; letter-spacing:-0.05em; }
    .about__grid { display:grid; grid-template-columns:1fr 1.1fr; gap:5rem; align-items:center; position:relative; }
    .about__frame { position:relative; }
    .about__frame::before { content:''; position:absolute; inset:-1.5rem -1.5rem 1.5rem 1.5rem; border:1px solid var(--gold-border); z-index:0; }
    .about__frame img { position:relative; z-index:1; width:100%; aspect-ratio:4/5; object-fit:cover; filter:grayscale(1) contrast(1.05) brightness(1.02) sepia(0.24) hue-rotate(-10deg); }
    .about__heading { font-family:var(--font-display); font-size:clamp(2.2rem,4vw,3.4rem); font-weight:400; line-height:1.15; margin:1rem 0 2rem; }
    .about__heading em { font-style:italic; color:var(--gold); }
    .about__text { color:var(--white-dim); margin-bottom:1.25rem; font-size:0.97rem; }
    .socios { display:flex; flex-direction:column; gap:0; margin:2.5rem 0; border-top:1px solid var(--gold-border); }
    .socio { display:flex; align-items:center; gap:1rem; padding:1.1rem 0.5rem 1.1rem 0; border-bottom:1px solid var(--gold-border); transition:padding-left 0.3s var(--ease), background 0.3s; }
    .socio:hover { padding-left:1rem; background:rgba(201,168,76,0.05); }
    .socio__name { font-family:var(--font-display); font-size:1.2rem; font-weight:500; color:var(--white); }
    .socio__area { margin-left:auto; font-size:0.8rem; letter-spacing:0.05em; color:var(--white-dim); }
    .socio svg { color:var(--gold); }
    .about__stats { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-top:1rem; }
    .about__stat-num { font-family:var(--font-display); font-size:2.2rem; font-weight:500; color:var(--gold); line-height:1; }
    .about__stat-label { font-size:0.7rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--white-dim); margin-top:0.4rem; line-height:1.4; }

    @media (max-width:1024px) {
      .areas__grid { grid-template-columns:1fr 1fr; }
      .about__grid { grid-template-columns:1fr; gap:3.5rem; }
      .about::before { display:none; }
    }
    @media (max-width:680px) {
      .areas__grid { grid-template-columns:1fr; }
      .hero__scroll { display:none; }
      .about__stats { grid-template-columns:1fr; gap:1rem; }
      .socio__area { margin-left:0; display:block; width:100%; }
      .socio { flex-wrap:wrap; gap:0.2rem; }
    }
  </style>
</Layout>
