---
// Página de conversão de Direito Criminal — destino dos anúncios de Rede de Pesquisa.
// Não usa o componente AreaPage (que segue servindo as outras quatro áreas):
// esta página tem estrutura própria, aprovada no planejamento de 22/10/2026.
// Promessa única: clareza sobre o caso da pessoa, agora. Nunca promessa de resultado.
// Régua OAB (Provimento 205/2021): sem desfechos obtidos, sem casos concretos,
// sem autoengrandecimento, sem comparação com colegas, sem honorários como captação.
import Layout from '../layouts/Layout.astro';

const B = (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/');
const WA = '5511953545061';
const TEL = '+5511953545061';
const TEL_LABEL = '(11) 95354-5061';
const wa = (texto) => `https://api.whatsapp.com/send?phone=${WA}&text=${encodeURIComponent(texto)}`;

// Mensagem neutra de propósito. Texto pré-escrito dizendo o que a pessoa fez é
// declaração escrita num aparelho que pode ser apreendido. Só é explícita na
// porta 1 (prisão) e na porta 3 (condenação), onde o fato já é público.
const WA_NEUTRO = 'Preciso falar com o escritório sobre um assunto reservado.';

const portas = [
  {
    id: 'preso-agora',
    rotulo: 'Alguém foi preso nas últimas horas',
    detalhe: 'Flagrante, audiência de custódia, pedido de liberdade. Aqui o tempo conta em horas.',
    cta: 'Preciso de orientação agora',
    msg: 'Alguém foi preso e eu preciso de orientação agora.',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  },
  {
    id: 'investigado',
    rotulo: 'Estou sendo investigado ou já fui denunciado',
    detalhe: 'Intimação para depoimento, inquérito, denúncia recebida, processo em andamento.',
    cta: 'Falar com o escritório',
    msg: WA_NEUTRO,
    icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/>',
  },
  {
    id: 'condenacao',
    rotulo: 'Já existe condenação e eu quero rever a situação',
    detalhe: 'Recursos, progressão de regime, execução da pena.',
    cta: 'Entender as opções',
    msg: 'Já existe condenação no caso e eu gostaria de entender as opções.',
    icon: '<path d="M4 21V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16"/><path d="M4 21h16"/><path d="M9 3v18M15 3v18"/>',
  },
];

const relogio = [
  {
    marco: 'Primeiras horas',
    texto: 'A pessoa é levada à delegacia e o auto de prisão em flagrante é lavrado. É o documento que vai descrever o que a polícia entendeu que aconteceu. Tudo o que vem depois é discutido a partir dele.',
  },
  {
    marco: 'Até 24 horas',
    texto: 'O caso é apresentado a um juiz na audiência de custódia. É nessa audiência que se decide se a pessoa responde presa ou solta — e é o primeiro momento em que a defesa pode falar.',
  },
  {
    marco: 'Depois da custódia',
    texto: 'Se a prisão foi mantida, cabe pedido de liberdade e habeas corpus. Se foi relaxada, começa a fase de investigação com a pessoa respondendo em liberdade.',
  },
];

const frentes = [
  {
    termo: 'Prisão em flagrante e audiência de custódia',
    traducao: 'Quando alguém foi preso agora e precisa ser apresentado a um juiz em até 24 horas.',
  },
  {
    termo: 'Habeas corpus e pedidos de liberdade',
    traducao: 'O instrumento para discutir uma prisão que já está em curso.',
  },
  {
    termo: 'Investigação e inquérito policial',
    traducao: 'A fase anterior à acusação formal, quando ainda se pode influenciar o rumo do caso.',
  },
  {
    termo: 'Crime tributário e sonegação',
    traducao: 'Acusações que nascem de autuação fiscal e atingem sócios e diretores.',
  },
  {
    termo: 'Crime ambiental',
    traducao: 'Responsabilização da empresa e de quem assina por ela.',
  },
  {
    termo: 'Execução penal e progressão de regime',
    traducao: 'Quando já existe condenação e o que está em jogo é o tempo e o modo de cumprimento.',
  },
];

const faq = [
  {
    q: 'Ainda não fui preso nem denunciado, só fui intimado para depor. Já é hora de procurar advogado?',
    a: 'É a fase em que a defesa tem mais instrumentos e menos gente procura. O que é dito em depoimento sem orientação costuma ser o que depois precisa ser explicado no processo.',
  },
  {
    q: 'Como funcionam os honorários?',
    a: 'São definidos caso a caso, conforme a fase do processo e a complexidade, e apresentados na primeira conversa antes de qualquer compromisso.',
  },
  {
    q: 'O caso envolve a empresa. Vocês defendem a pessoa jurídica?',
    a: 'Sim — e também os sócios, diretores e executivos individualmente, que em crimes ambientais e tributários costumam responder junto.',
  },
  {
    q: 'É madrugada. Alguém vai ler minha mensagem agora?',
    a: 'Sim. O atendimento inicial funciona 24 horas e responde de imediato, registrando a situação e orientando o que fazer nas próximas horas. O advogado assume o caso em seguida.',
  },
  {
    q: 'Vocês atendem fora de São Paulo?',
    a: 'Sim, em todo o território nacional, com atuação também nos tribunais superiores em Brasília.',
  },
  {
    q: 'Como eu acompanho o que está acontecendo no processo?',
    a: 'Você recebe o cenário atualizado a cada movimentação relevante, em linguagem que não exige intérprete.',
  },
];

const metaTitle = 'Advocacia Criminal — Atendimento 24 horas | Mendonça & Ferreira Advocacia';
const metaDesc = 'Orientação em prisão em flagrante, audiência de custódia, habeas corpus, investigação, crime tributário, crime ambiental e execução penal. Atendimento inicial imediato pelo WhatsApp, a qualquer hora. Dr. Mailson Mendonça Ferreira — OAB/SP 355.869.';
---

<Layout title={metaTitle} description={metaDesc} areaWaMsg={WA_NEUTRO}>

  <!-- 1. HERO -->
  <section class="ch">
    <div class="ch__bg" style={`background-image: url('${B}images/hero-bg.jpg')`}></div>
    <div class="ch__overlay"></div>
    <div class="container ch__wrap">
      <span class="ch__human">São Paulo e região. Atendimento a qualquer hora.</span>
      <h1 class="ch__title">
        Você não precisa entender de direito penal.<br>
        <em>Precisa saber o que vai acontecer agora.</em>
      </h1>
      <p class="ch__sub">
        Atendimento inicial imediato pelo WhatsApp, dia ou noite. Você descreve o que aconteceu,
        entende quais são os próximos passos e fala com o advogado responsável pelo caso.
      </p>
      <div class="ch__actions">
        <a href={wa(WA_NEUTRO)} class="btn btn-filled" target="_blank" rel="noopener">
          <span>Descrever minha situação agora</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href={`tel:${TEL}`} class="btn"><span>Ligar: {TEL_LABEL}</span></a>
      </div>
      <p class="ch__oab">Dr. Mailson Mendonça Ferreira — OAB/SP 355.869</p>
    </div>
  </section>

  <!-- 2. BIFURCAÇÃO -->
  <section class="situacao" id="situacao">
    <div class="container">
      <div class="sec-head reveal">
        <span class="gold-line"></span>
        <span class="label">Qual é a sua situação</span>
        <h2 class="sec-title">Em que ponto <em>você está?</em></h2>
      </div>
      <div class="portas">
        {portas.map((p, i) => (
          <div class={`porta reveal reveal-delay-${i + 1}`} id={p.id}>
            <svg class="porta__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" set:html={p.icon}></svg>
            <h3 class="porta__rotulo">{p.rotulo}</h3>
            <p class="porta__detalhe">{p.detalhe}</p>
            <a href={wa(p.msg)} class="btn porta__cta" target="_blank" rel="noopener">
              <span>{p.cta}</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. O RELÓGIO -->
  <section class="relogio" id="relogio">
    <div class="container">
      <div class="sec-head reveal">
        <span class="gold-line"></span>
        <span class="label">A ordem em que as coisas acontecem</span>
        <h2 class="sec-title">O que acontece depois de uma <em>prisão em flagrante</em></h2>
      </div>
      <div class="linha">
        {relogio.map((r, i) => (
          <div class={`linha__item reveal reveal-delay-${i + 1}`}>
            <span class="linha__dot"></span>
            <h3 class="linha__marco">{r.marco}</h3>
            <p class="linha__texto">{r.texto}</p>
          </div>
        ))}
      </div>
      <p class="relogio__fecho reveal">
        <strong>Qual desses caminhos é o seu depende de três coisas:</strong> o que exatamente está
        escrito no auto, quem estava presente e o que já foi dito em depoimento. Não dá para saber
        isso por fora. Dá para saber em uma conversa.
      </p>
    </div>
  </section>

  <!-- 4. QUEM CONDUZ O CASO -->
  <section class="quem">
    <div class="container quem__grid">
      <div class="quem__frame reveal-left">
        <img class="quem__img" src={`${B}images/advogado.jpg`} alt="Dr. Mailson Mendonça Ferreira" />
      </div>
      <div class="quem__meta reveal-right">
        <span class="gold-line"></span>
        <span class="label">Quem conduz o caso</span>
        <h2 class="quem__nome">Dr. Mailson Mendonça Ferreira</h2>
        <p class="quem__oab">OAB/SP 355.869</p>
        <p class="quem__texto">
          Atuação concentrada em direito criminal, com ênfase em casos que envolvem empresas e seus
          gestores — crimes ambientais, tributários e contra a ordem econômica — e em atendimento de
          urgência em prisão em flagrante e habeas corpus.
        </p>
        <p class="quem__texto">
          O caso é conduzido por ele do primeiro contato à decisão final. Você não vai ser
          transferido entre pessoas que não conhecem o seu processo.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. AS PRIMEIRAS 48 HORAS -->
  <section class="process">
    <div class="container">
      <div class="sec-head reveal">
        <span class="gold-line"></span>
        <span class="label">Como conduzimos</span>
        <h2 class="sec-title">O que acontece do nosso lado, nas <em>primeiras 48 horas</em></h2>
      </div>
      <div class="process__steps">
        <div class="process__step reveal">
          <div class="process__step-dot" data-step="0">I</div>
          <h3 class="process__step-title">Você descreve a situação</h3>
          <p class="process__step-text">No WhatsApp, a qualquer hora. O atendimento inicial registra o que aconteceu, onde a pessoa está e o que já foi feito.</p>
        </div>
        <div class="process__step reveal reveal-delay-1">
          <div class="process__step-dot" data-step="1">II</div>
          <h3 class="process__step-title">Localizamos o caso</h3>
          <p class="process__step-text">Distrito policial, número do auto, se a custódia já foi designada. Sem isso, qualquer opinião sobre o caso é chute.</p>
        </div>
        <div class="process__step reveal reveal-delay-2">
          <div class="process__step-dot" data-step="2">III</div>
          <h3 class="process__step-title">Lemos os documentos</h3>
          <p class="process__step-text">O auto de prisão, os depoimentos já tomados, o que a acusação está sustentando.</p>
        </div>
        <div class="process__step reveal reveal-delay-3">
          <div class="process__step-dot" data-step="3">IV</div>
          <h3 class="process__step-title">Você recebe o cenário</h3>
          <p class="process__step-text">Quais são os caminhos possíveis, qual o prazo de cada um e o que depende de decisão de terceiros. Com franqueza, inclusive sobre o que é difícil.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. SIGILO -->
  <section class="sigilo" id="sigilo">
    <div class="container sigilo__wrap">
      <span class="gold-line reveal"></span>
      <span class="label reveal">Sigilo</span>
      <h2 class="sigilo__title reveal reveal-delay-1">O que você contar aqui <em>não sai daqui.</em></h2>
      <p class="sigilo__texto reveal reveal-delay-2">
        O sigilo entre advogado e cliente é protegido pelo Estatuto da OAB e pela Constituição.
        Não é política interna do escritório, é lei — e vale desde a primeira mensagem no WhatsApp,
        antes de qualquer contratação.
      </p>
      <ul class="sigilo__lista reveal reveal-delay-3">
        <li>Nenhum terceiro é informado de que você procurou o escritório.</li>
        <li>O atendimento pode ser feito por ligação, sem nada escrito.</li>
        <li>Reuniões presenciais são agendadas em horário reservado.</li>
      </ul>
      <p class="sigilo__instrucao reveal reveal-delay-4">
        Se você preferir não escrever nada sobre o assunto, mande apenas
        <a href={wa('Preciso falar.')} target="_blank" rel="noopener">“preciso falar”</a>
        e aguarde o retorno.
      </p>
    </div>
  </section>

  <!-- 7. FRENTES DE ATUAÇÃO -->
  <section class="frentes" id="frentes">
    <div class="container">
      <div class="sec-head reveal">
        <span class="gold-line"></span>
        <span class="label">Frentes de atuação</span>
        <h2 class="sec-title">Em que tipo de caso o escritório <em>atua</em></h2>
      </div>
      <div class="frentes__grid">
        {frentes.map((f, i) => (
          <div class="frente reveal">
            <span class="frente__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="frente__termo">{f.termo}</h3>
            <p class="frente__traducao">{f.traducao}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="faq" id="duvidas">
    <div class="container">
      <div class="faq__grid">
        <div>
          <span class="gold-line reveal"></span>
          <span class="label reveal">Antes da contratação</span>
          <h2 class="faq__heading reveal reveal-delay-1">Perguntas que<br>chegam primeiro.<em> Respondemos.</em></h2>
        </div>
        <div class="faq__list reveal">
          {faq.map((item) => (
            <div class="faq__item">
              <div class="faq__question">
                <span class="faq__q-text">{item.q}</span>
                <svg class="faq__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
              </div>
              <div class="faq__answer"><p class="faq__answer-text">{item.a}</p></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 9. CTA FINAL -->
  <section class="cta-section">
    <div class="cta__corner cta__corner--tl"></div>
    <div class="cta__corner cta__corner--tr"></div>
    <div class="cta__corner cta__corner--bl"></div>
    <div class="cta__corner cta__corner--br"></div>
    <div class="container">
      <span class="gold-line reveal"></span>
      <span class="label reveal">Fale com o escritório</span>
      <h2 class="cta__heading reveal reveal-delay-1">A dúvida não melhora com o tempo.<br><em>O caso, às vezes, sim.</em></h2>
      <p class="cta__sub reveal reveal-delay-2">
        Descreva a situação. Você vai receber o retorno com o que acontece agora, quais são os
        prazos e o que depende de decisão sua.
      </p>
      <div class="cta__actions reveal reveal-delay-3">
        <a href={wa(WA_NEUTRO)} class="btn btn-filled" target="_blank" rel="noopener">
          <span>Falar com o escritório agora</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href={`tel:${TEL}`} class="btn"><span>Ligar: {TEL_LABEL}</span></a>
      </div>
      <p class="cta__disclaimer reveal">Atendimento 24 horas. Dr. Mailson Mendonça Ferreira — OAB/SP 355.869.</p>
    </div>
  </section>

  <style>
    /* 1. HERO — sem 100vh de propósito: a bifurcação precisa aparecer logo abaixo */
    .ch { position:relative; padding:12rem 0 5rem; overflow:hidden; border-bottom:1px solid var(--gold-border); }
    .ch__bg { position:absolute; inset:0; background-size:cover; background-position:center; filter:grayscale(0.75) contrast(1.05) sepia(0.14); transform:scale(1.04); }
    .ch__overlay { position:absolute; inset:0; background:linear-gradient(to bottom, rgba(10,10,10,0.72) 0%, rgba(10,10,10,0.85) 45%, rgba(10,10,10,0.97) 100%); }
    .ch__overlay::after { content:''; position:absolute; inset:0; background:radial-gradient(ellipse 70% 60% at 15% 35%, rgba(201,168,76,0.09), transparent); }
    .ch__wrap { position:relative; z-index:2; max-width:860px; }
    .ch__human { display:inline-block; font-size:0.72rem; font-weight:500; letter-spacing:0.2em; text-transform:uppercase; color:var(--gold); margin-bottom:1.6rem; padding-left:2.5rem; position:relative; animation:chUp 0.9s var(--ease) 0.2s both; }
    .ch__human::before { content:''; position:absolute; left:0; top:50%; width:32px; height:1px; background:var(--gold); }
    .ch__title { font-family:var(--font-display); font-size:clamp(2.3rem,5.2vw,4.4rem); font-weight:300; line-height:1.08; letter-spacing:-0.01em; margin-bottom:1.5rem; animation:chUp 0.9s var(--ease) 0.35s both; }
    .ch__title em { font-style:italic; color:var(--gold); }
    .ch__sub { font-size:1.08rem; color:var(--white-dim); max-width:620px; line-height:1.7; margin-bottom:2.5rem; animation:chUp 0.9s var(--ease) 0.5s both; }
    .ch__actions { display:flex; gap:1rem; flex-wrap:wrap; animation:chUp 0.9s var(--ease) 0.65s both; }
    .ch__oab { margin-top:2rem; font-size:0.78rem; letter-spacing:0.1em; color:var(--white-dim); animation:chUp 0.9s var(--ease) 0.8s both; }
    @keyframes chUp { from{opacity:0;transform:translateY(20px);} to{opacity:1;transform:translateY(0);} }

    /* 2. BIFURCAÇÃO */
    .situacao { padding:6rem 0; background:var(--black); }
    .portas { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5px; background:var(--gold-border); border:1.5px solid var(--gold-border); }
    .porta { background:var(--dark); padding:2.75rem 2.25rem; display:flex; flex-direction:column; align-items:flex-start; gap:0.9rem; transition:background 0.4s var(--ease); }
    .porta:hover { background:var(--dark-3); }
    .porta__icon { width:40px; height:40px; color:var(--gold); opacity:0.9; }
    .porta__rotulo { font-family:var(--font-display); font-size:1.42rem; font-weight:500; line-height:1.22; }
    .porta__detalhe { font-size:0.9rem; color:var(--white-dim); line-height:1.7; flex-grow:1; }
    .porta__cta { margin-top:0.5rem; padding:0.9rem 1.6rem; font-size:0.68rem; }

    /* 3. O RELÓGIO */
    .relogio { padding:7rem 0; background:var(--dark-2); position:relative; }
    .relogio::before { content:''; position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(to right,transparent,var(--gold),transparent); }
    .linha { max-width:760px; margin:0 auto; position:relative; padding-left:2.5rem; }
    .linha::before { content:''; position:absolute; left:7px; top:0.6rem; bottom:0.6rem; width:1px; background:var(--gold-border); }
    .linha__item { position:relative; padding-bottom:2.75rem; }
    .linha__item:last-child { padding-bottom:0; }
    .linha__dot { position:absolute; left:-2.5rem; top:0.45rem; width:15px; height:15px; border:1px solid var(--gold); background:var(--dark-2); transform:rotate(45deg); }
    .linha__marco { font-family:var(--font-display); font-size:1.35rem; font-weight:500; color:var(--gold); margin-bottom:0.5rem; }
    .linha__texto { font-size:0.97rem; color:var(--white-dim); line-height:1.8; }
    .relogio__fecho { max-width:760px; margin:3.5rem auto 0; padding:1.75rem 2rem; border:1px solid var(--gold-border); background:var(--dark); font-size:0.97rem; color:var(--white-dim); line-height:1.8; }
    .relogio__fecho strong { color:var(--white); font-weight:500; }

    /* 4. QUEM CONDUZ O CASO */
    .quem { padding:7rem 0; background:var(--black); }
    .quem__grid { display:grid; grid-template-columns:1fr 1.4fr; gap:4.5rem; align-items:center; }
    .quem__frame { position:relative; }
    .quem__frame::before { content:''; position:absolute; inset:-1rem -1rem 1rem 1rem; border:1px solid var(--gold-border); }
    .quem__img { position:relative; z-index:1; width:100%; aspect-ratio:4/5; object-fit:cover; object-position:top center; filter:grayscale(1) contrast(1.05) brightness(1.03) sepia(0.26) hue-rotate(-10deg); }
    .quem__nome { font-family:var(--font-display); font-size:clamp(1.9rem,3.2vw,2.6rem); font-weight:400; line-height:1.15; margin-top:1rem; }
    .quem__oab { font-size:0.8rem; letter-spacing:0.1em; color:var(--gold); margin-top:0.4rem; margin-bottom:1.5rem; }
    .quem__texto { font-size:0.98rem; color:var(--white-dim); line-height:1.85; margin-bottom:1.2rem; }

    /* 6. SIGILO */
    .sigilo { padding:7rem 0; background:var(--dark-3); position:relative; }
    .sigilo::before { content:''; position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(to right,transparent,var(--gold),transparent); }
    .sigilo__wrap { max-width:820px; }
    .sigilo__title { font-family:var(--font-display); font-size:clamp(2rem,3.8vw,3rem); font-weight:400; line-height:1.18; margin:1rem 0 1.5rem; }
    .sigilo__title em { font-style:italic; color:var(--gold); }
    .sigilo__texto { font-size:1rem; color:var(--white-dim); line-height:1.85; margin-bottom:1.75rem; }
    .sigilo__lista { list-style:none; display:flex; flex-direction:column; gap:0.9rem; margin-bottom:2rem; }
    .sigilo__lista li { position:relative; padding-left:1.75rem; font-size:0.97rem; color:var(--white-dim); line-height:1.7; }
    .sigilo__lista li::before { content:''; position:absolute; left:0; top:0.55rem; width:8px; height:8px; border:1px solid var(--gold); transform:rotate(45deg); }
    .sigilo__instrucao { font-family:var(--font-display); font-size:1.3rem; font-weight:400; color:var(--white); line-height:1.5; }
    .sigilo__instrucao a { color:var(--gold); border-bottom:1px solid var(--gold-border); transition:border-color 0.3s; }
    .sigilo__instrucao a:hover { border-color:var(--gold); }

    /* 7. FRENTES DE ATUAÇÃO */
    .frentes { padding:7rem 0; background:var(--black); }
    .frentes__grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5px; background:var(--gold-border); border:1.5px solid var(--gold-border); }
    .frente { background:var(--dark); padding:2.5rem 2rem; position:relative; overflow:hidden; transition:background 0.4s var(--ease); }
    .frente:hover { background:var(--dark-3); }
    .frente__num { font-family:var(--font-display); font-size:0.95rem; font-style:italic; color:var(--gold); }
    .frente__termo { font-family:var(--font-display); font-size:1.3rem; font-weight:500; line-height:1.25; margin:0.4rem 0 0.7rem; }
    .frente__traducao { font-size:0.9rem; color:var(--white-dim); line-height:1.7; }

    /* RESPONSIVO */
    @media (max-width:1024px) {
      .portas { grid-template-columns:1fr; }
      .frentes__grid { grid-template-columns:repeat(2,1fr); }
      .quem__grid { grid-template-columns:1fr; gap:3rem; }
      .quem__frame { max-width:340px; }
    }
    @media (max-width:768px) {
      /* O botão flutuante de WhatsApp fica fixo no canto inferior direito.
         O bloco de CTA do hero precisa terminar acima dele, senão o círculo
         verde cobre o botão de ligar. Daí o aperto de espaçamento abaixo. */
      .ch { padding:7.5rem 0 3.5rem; }
      .ch__human { margin-bottom:1.1rem; }
      .ch__title { font-size:2.05rem; margin-bottom:1.1rem; }
      .ch__sub { font-size:1rem; margin-bottom:1.8rem; }
      .ch__oab { margin-top:1.5rem; }
      .ch__actions { flex-direction:column; align-items:stretch; }
      .ch__actions .btn { justify-content:center; }
      .situacao { padding:4.5rem 0; }
      .frentes__grid { grid-template-columns:1fr; }
      .relogio__fecho { padding:1.5rem 1.25rem; }
    }
  </style>
</Layout>
